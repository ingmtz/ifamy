Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /PITS-BATCH/
RewriteRule ^(?:application|system|database|tests|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^assets/batch/[^/]+\.(?:css|js|png)$ - [L]
RewriteRule ^index\.php(?:/|$) - [L]
RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>
