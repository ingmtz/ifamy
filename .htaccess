Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /PITS-TAGS/
RewriteRule ^(?:application|system|database|tests|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^assets/tags/[^/]+\.(?:css|js|png|mp3)$ - [L]
RewriteRule ^index\.php(?:/|$) - [L]
RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>
